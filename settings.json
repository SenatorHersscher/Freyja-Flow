{
    // Inline / Ghost text / Tam kod tamamlamalarını kapatır
    "editor.inlineSuggest.enabled": false,
    "editor.suggest.preview": false,
    // '.' (nokta) koyulduğunda metod ve özellik listesinin (IntelliSense) açılmasını sağlar
    "editor.suggestOnTriggerCharacters": true,
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    // Otomatik tamamlama açılır menü ayarları
    "editor.acceptSuggestionOnEnter": "on",
    "editor.suggestSelection": "first"
}
